<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_default_background"
    tools:context=".MainActivity">

    <!-- ======================================== -->
    <!-- 1. Title Bar -->
    <!-- ======================================== -->

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:background="@color/municipality_tianjin"
        android:text="@string/main_title"
        android:textColor="@color/color_text_light"
        android:textSize="20sp"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ======================================== -->
    <!-- 2. Municipality Map -->
    <!-- ======================================== -->

    <ImageView
        android:id="@+id/ivMunicipalities"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="24dp"
        android:src="@drawable/chinese_municipalities"
        android:contentDescription="@string/main_title"
        android:scaleType="fitCenter"

        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintBottom_toTopOf="@id/tvInputLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ======================================== -->
    <!-- 3. Input Label -->
    <!-- ======================================== -->

    <TextView
        android:id="@+id/tvInputLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="6dp"
        android:text="@string/input_label"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/color_text_dark"

        app:layout_constraintBottom_toTopOf="@id/etMunicipality"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- ======================================== -->
    <!-- 4. Input Field -->
    <!-- ======================================== -->

    <EditText
        android:id="@+id/etMunicipality"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="64dp"
        android:hint="@string/input_hint"
        android:inputType="textCapWords"
        android:maxLines="1"
        android:imeOptions="actionGo"
        android:textSize="16sp"
        android:textColor="@color/color_text_dark"
        android:selectAllOnFocus="false"

        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
